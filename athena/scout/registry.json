{
  "registryVersion": 2,
  "note": "Athena intent registry for the Scout Intent engine (Meterless spec: engines/scout-intent/docs/intent-registry.md). Small domain registry; GENERAL is the safe fallback for scores below the Reject band.",
  "intents": [
    {
      "id": "GENERAL",
      "category": "general",
      "description": "Safe fallback when no registered intent clears the Reject band. Responds conversationally, never routes to data or model tools, never guesses a higher-risk intent.",
      "parameters": {
        "type": "object",
        "properties": {}
      },
      "capabilities": [],
      "riskClass": "low",
      "surfaces": [
        "web",
        "api"
      ],
      "roles": [
        "*"
      ],
      "triggers": {
        "hello": 0.6,
        "hi": 0.4,
        "what can you do": 1.0,
        "who are you": 1.0,
        "thanks": 0.6,
        "thank you": 0.6,
        "hey": 0.5,
        "good morning": 0.8,
        "good evening": 0.8,
        "cheers": 0.6,
        "how does this work": 1.0,
        "what can you help": 1.5,
        "how does": 0.5,
        "what is this": 0.8
      },
      "examples": [
        "hello",
        "what can you help me with",
        "who are you",
        "thanks",
        "good evening",
        "how does this work"
      ],
      "version": 2
    },
