# Copy to .env and fill in. Never commit .env. Placeholders only in this file.

# Run offline: local data files and a labelled offline model stand-in, no gateway calls.
SAMPLE_MODE=false

# --- MODELS: the COMP3110 LiteLLM gateway (Tech 1). The key comes from your onboarding email. ---
COMP3110_MODEL_BASE_URL=https://lllm.cs3110.cse.academy/v1
COMP3110_API_KEY=YOUR_VIRTUAL_KEY
# One model per role. Confirm each ID with GET $COMP3110_MODEL_BASE_URL/models before use.
# Provisional until evals/compare_models.py picks them; the judge is a different family from the explainer.
EXPLAINER_MODEL=scx-gemma-4-31B-it
CRITIC_MODEL=scx-gpt-oss-120b
MODERATOR_MODEL=scx-gpt-oss-120b
JUDGE_MODEL=scx-Meta-Llama-3.3-70B-Instruct
# Used for the single retry when the primary route fails (429, 5xx, timeout). Empty = retry the same model.
# gpt-oss-120b-bedrock was the approved fallback during the Tech 7 SCX outage; it has no course price.
FALLBACK_MODEL=
LLM_TIMEOUT_S=60

# Report classifier: moderator-v1 (hackathon prompt) until the team chooses from
# evals/results/classifier_dev.json. Options: majority, keyword, tfidf-logreg, tfidf-svm, prompt-zero, prompt-5shot
REPORT_CLASSIFIER=moderator-v1

# --- DATA: files (default, baked into the image) or zetaris (optional adapter) ---
DATA_BACKEND=files
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-zetaris-sign-in-email
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_SCHEMA=athena

# --- Rate limit ---
# Per-deployment secret that keys the hashed client id used by the rate limit (any long random string).
# Name kept from the removed Scout chat router.
SCOUT_SECRET=change-me-to-a-long-random-string
MAX_REVISIONS=2

# Journey planner: live OpenTripPlanner (optional). Leave empty to use the precomputed alternatives.
OTP_URL=
OTP_TIMEOUT_S=20
