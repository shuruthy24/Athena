# Copy to .env and fill in. Never commit .env. Placeholders only in this file.

# Run without Zetaris or Nightshift (local JSON data + labelled offline model stand-in)
SAMPLE_MODE=false

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-zetaris-sign-in-email
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_SCHEMA=athena

# --- POWER: Meterless Nightshift Runtime (values from Nightshift's Console) ---
# The NVIDIA API key is NOT set here: it lives only in Nightshift's Providers/Keys page.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-authentication-token
# Pin Nemotron-backed routes from GET /v1/models (see README). meterless/auto may pick another model.
FAST_MODEL=meterless/auto
CRITIC_MODEL=meterless/auto

# --- Scout Intent ---
# Per-deployment secret for signing execution contracts (any long random string)
SCOUT_SECRET=change-me-to-a-long-random-string
MAX_REVISIONS=2

# Journey planner: live OpenTripPlanner (optional). Leave empty to use the precomputed alternatives.
OTP_URL=
OTP_TIMEOUT_S=20
